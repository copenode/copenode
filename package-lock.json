{
  "name": "copenode-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "copenode-monorepo",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@copenode/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@copenode/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/copenode": {
      "resolved": "packages/meta",
      "link": true
    },
    "packages/cli": {
      "name": "@copenode/cli",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@copenode/core": "^0.1.0"
      },
      "bin": {
        "copenode": "bin/copenode.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@copenode/core",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/meta": {
      "name": "copenode",
      "version": "0.0.2",
      "license": "MIT"
    }
  }
}
