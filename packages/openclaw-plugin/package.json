{
  "name": "@copenode/openclaw-plugin",
  "version": "0.0.1",
  "description": "copenode for OpenClaw: governed Paseo spawns from chat. Every requester is identified, policy-checked, budgeted, and witnessed by the spine.",
  "type": "module",
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": ">=2026.11.6",
      "minGatewayVersion": "2026.11.6"
    },
    "build": {
      "openclawVersion": "2026.11.6",
      "pluginSdkVersion": "2026.11.6"
    }
  },
  "scripts": {
    "test": "node --test spine.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "copenode",
    "paseo",
    "agents",
    "governance",
    "metering"
  ],
  "dependencies": {
    "@copenode/core": "^0.1.0",
    "typebox": "^1.4.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copenode/copenode.git",
    "directory": "packages/openclaw-plugin"
  },
  "homepage": "https://copenode.com",
  "bugs": {
    "url": "https://github.com/copenode/copenode/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
